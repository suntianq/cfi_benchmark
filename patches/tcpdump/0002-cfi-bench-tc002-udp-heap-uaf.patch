+	/*
+	 * [CFI-BENCHMARK-INJECT] TC-002 触发点：合成堆 UAF（CWE-416）。
+	 * payload 以 magic "CFIBENCH2" 开头时：分配回调对象并置回调 →
+	 * free（悬空指针未置空）→ 同尺寸 malloc 复用同一块内存并以报文
+	 * 数据整体填充 → 通过悬空指针发起间接调用。正常报文不触发。
+	 */
+	if (ND_TTEST_LEN(cp, CFIB2_MAGIC_LEN + 2) &&
+	    memcmp(cp, CFIB2_MAGIC, CFIB2_MAGIC_LEN) == 0) {
+		uint16_t dlen = (uint16_t)
+		    ((GET_U_1(cp + CFIB2_MAGIC_LEN) << 8) |
+		     GET_U_1(cp + CFIB2_MAGIC_LEN + 1));
+		struct cfib_uaf_obj *obj;
+
+		obj = (struct cfib_uaf_obj *)malloc(sizeof(*obj));
+		if (obj == NULL)
+			goto invalid;
+		obj->fn = cfib_uaf_benign_cb;
+		memset(obj->buf, 0, sizeof(obj->buf));
+		free(obj);		/* 漏洞点：obj 未置空 */
+		obj = (struct cfib_uaf_obj *)malloc(sizeof(*obj));
+		if (obj == NULL)
+			goto invalid;
+		if (dlen > sizeof(*obj))
+			dlen = (uint16_t)sizeof(*obj);
+		memcpy(obj, cp + CFIB2_MAGIC_LEN + 2, dlen);
+		ND_PRINT("[cfi-bench] uaf call\n");
+		obj->fn((char *)obj->buf);	/* 漏洞点：悬空指针间接调用 */
+	}

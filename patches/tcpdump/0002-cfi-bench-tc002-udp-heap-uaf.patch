+ */
+#define CFIB2_MAGIC	"CFIBENCH2"
+#define CFIB2_MAGIC_LEN	9
+
+struct cfib_uaf_obj {
+	void (*volatile fn)(char *);	/* volatile：防止编译器把释放后读取外提 */
+	unsigned char buf[0x50];
+};
+
+static void
+cfib_uaf_benign_cb(char *arg _U_)
+{
+	(void)arg;
+	/* 无实际操作：正常对象回调路径，仅用于占位 */
+}
+
 void
 udp_print(netdissect_options *ndo, const u_char *bp, u_int length,
 	  const u_char *bp2, int fragmented, u_int ttl_hl)
